generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------
// Webhook Events
// ------------------------------------------------------------------

model WebhookEvent {
  id          String    @id @default(cuid())
  platform    String
  eventId     String    @unique
  status      String
  postId      String?
  receivedAt  DateTime  @default(now())
  rawPayload  Json?
  processed   Boolean   @default(false)
  processedAt DateTime?

  @@index([platform])
  @@index([eventId])
}
