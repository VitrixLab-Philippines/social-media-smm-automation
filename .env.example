# SMMA Automation - Environment Configuration
# 
# Copy this file to .env and fill in required values.
# Do not commit the .env file to version control (it is gitignored).

# ==========================================
# Public / Browser-safe variables
# ==========================================
# These values are safe to expose to the client
NEXT_PUBLIC_APP_URL=http://localhost:3000
 
# Authentication
SESSION_SECRET=PLACEHOLDER_MUST_CHANGE_IN_PRODUCTION

# OAuth / Social
NEXT_PUBLIC_GOOGLE_CLIENT_ID=PLACEHOLDER
GOOGLE_CLIENT_SECRET=PLACEHOLDER
NEXT_PUBLIC_GOOGLE_PROJECT_ID=PLACEHOLDER
META_ACCESS_TOKEN=PLACEHOLDER
META_PAGE_ID=PLACEHOLDER

# AI Provider
AI_PROVIDER=stub
NVIDIA_API_KEY=PLACEHOLDER
OPENROUTER_API_KEY=PLACEHOLDER

# Queue / Redis
REDIS_URL=redis://localhost:6379

# Application
DRY_RUN=true

# ==========================================
# Public (safe to expose)
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# Server-only — DO NOT commit real values
# ==========================================
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require

SESSION_SECRET=replace-with-openssl-rand-base64-32
JWT_SECRET=replace-with-openssl-rand-base64-32

OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
REDIS_URL=redis://localhost:6379

DRY_RUN=true