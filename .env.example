# SMMA Automation - Environment Configuration
# 
# Copy this file to .env and fill in required values.
# Do not commit the .env file to version control (it is gitignored).

# ==========================================
# Public / Browser-safe variables
# ==========================================
# These values are safe to expose to the client
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# Server-only variables (DO NOT expose as NEXT_PUBLIC_*)
# ==========================================
# Database
DATABASE_URL=postgresql://neondb_owner:PLACEHOLDER@ep-weather-12345678-us-east-2.aws.neon.tech/neondb?sslmode=direct
DIRECT_URL=postgresql://neondb_owner:PLACEHOLDER@ep-weather-12345678-us-east-2.aws.neon.tech/neondb?sslmode=direct

# Authentication
SESSION_SECRET=PLACEHOLDER_MUST_CHANGE_IN_PRODUCTION

# OAuth / Social
NEXT_PUBLIC_GOOGLE_CLIENT_ID=PLACEHOLDER
GOOGLE_CLIENT_SECRET=PLACEHOLDER
NEXT_PUBLIC_GOOGLE_PROJECT_ID=PLACEHOLDER
META_ACCESS_TOKEN=PLACEHOLDER
META_PAGE_ID=PLACEHOLDER

# AI Provider
AI_PROVIDER=stub
NVIDIA_API_KEY=PLACEHOLDER
OPENROUTER_API_KEY=PLACEHOLDER

# Queue / Redis
REDIS_URL=redis://localhost:6379

# Application
DRY_RUN=true